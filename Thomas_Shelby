<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Thomas Shelby Vault v3.7</title>
  <!-- Supabase JS Client -->
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    :root {
      --bg-color: #0d0d0d;
      --card-bg: #181818;
      --gold: #d4af37;
      --text: #e0e0e0;
    }
    body {
      background-color: var(--bg-color);
      color: var(--text);
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      margin: 0;
      padding: 20px;
    }
    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 20px;
      border-bottom: 1px solid #333;
    }
    h1 { color: var(--gold); margin: 0; font-size: 1.8rem; }
    .btn {
      background: var(--gold);
      color: #000;
      border: none;
      padding: 10px 18px;
      border-radius: 6px;
      font-weight: bold;
      cursor: pointer;
    }
    .upload-box {
      display: none;
      background: var(--card-bg);
      padding: 20px;
      border-radius: 8px;
      margin: 20px 0;
      border: 1px solid var(--gold);
    }
    .upload-box.show { display: block; }
    .gallery {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: 20px;
      margin-top: 20px;
    }
    .card {
      background: var(--card-bg);
      border-radius: 8px;
      overflow: hidden;
      border: 1px solid #282828;
    }
    .card img, .card video {
      width: 100%;
      height: 200px;
      object-fit: cover;
    }
    .card-body { padding: 15px; }
    .toast {
      position: fixed;
      bottom: 20px;
      right: 20px;
      background: var(--gold);
      color: #000;
      padding: 12px 20px;
      border-radius: 6px;
      font-weight: bold;
      display: none;
      z-index: 1000;
    }
  </style>
</head>
<body>

  <header>
    <h1><i class="fa-solid fa-vault"></i> Thomas Shelby Vault</h1>
    <button class="btn" onclick="toggleAdmin()">
      <i class="fa-solid fa-user-shield"></i> <span id="adminBtnText">المشرف</span>
    </button>
  </header>

  <div id="uploadBox" class="upload-box">
    <h3><i class="fa-solid fa-upload"></i> رفع ملف جديد للخزنة</h3>
    <input type="text" id="assetTitle" placeholder="عنوان الملف..." style="width:100%; padding:8px; margin-bottom:10px;">
    <input type="file" id="assetFile" accept="image/*,video/*" style="margin-bottom:10px;">
    <button class="btn" onclick="uploadAsset()">رفع الملف</button>
  </div>

  <div id="gallery" class="gallery"></div>
  <div id="toast" class="toast"></div>

  <script>
    // إعدادات Supabase
    const SUPABASE_URL = "https://ymjdiambpwydtduqazlk.supabase.co";
    const SUPABASE_KEY = "sb_publishable_N9C0j-bSgkDrOfzUxOC3bQ_FLXJbT1k";
    const _supabase = supabase.createClient(SUPABASE_URL, SUPABASE_KEY);

    let isAdmin = false;

    function showToast(msg) {
      const toast = document.getElementById('toast');
      toast.textContent = msg;
      toast.style.display = 'block';
      setTimeout(() => { toast.style.display = 'none'; }, 3000);
    }

    // دالة الأدمن بكلمة مرور admin123
    function toggleAdmin() {
      if (isAdmin) {
        isAdmin = false;
        document.getElementById('uploadBox').classList.remove('show');
        document.getElementById('adminBtnText').textContent = 'المشرف';
        showToast('🔒 تم تسجيل الخروج');
        render();
        return;
      }
      const pass = prompt('أدخل كلمة مرور المشرف الملكية:');
      if (pass === 'admin123') {
        isAdmin = true;
        document.getElementById('uploadBox').classList.add('show');
        document.getElementById('adminBtnText').textContent = 'خروج المشرف';
        showToast('🔓 مرحباً بك يا سي شيلبي');
        render();
      } else if (pass !== null) {
        alert('❌ كلمة المرور غير صحيحة!');
      }
    }

    // دالة عرض وسائط المعرض
    async function render() {
      const gallery = document.getElementById('gallery');
      gallery.innerHTML = '<p>جاري تحميل الأرشيف...</p>';

      const { data, error } = await _supabase.from('photos').select('*').order('created_at', { ascending: false });
      if (error) {
        gallery.innerHTML = '<p>حدث خطأ أثناء تحميل البيانات.</p>';
        return;
      }

      gallery.innerHTML = '';
      data.forEach(item => {
        const isVideo = item.url.includes('.mp4') || item.url.includes('.webm');
        const card = document.createElement('div');
        card.className = 'card';
        card.innerHTML = `
          ${isVideo ? `<video src="${item.url}" controls></video>` : `<img src="${item.url}">`}
          <div class="card-body">
            <h4>${item.title || 'بدون عنوان'}</h4>
            <button onclick="downloadAsset('${item.url}', '${item.title}', '${item.id}')" class="btn" style="width:100%; margin-top:5px;">
              <i class="fa-solid fa-download"></i> تنزيل
            </button>
            ${isAdmin ? `<button onclick="deleteAsset('${item.id}', '${item.storage_path}')" style="width:100%; margin-top:5px; background:#c0392b; color:#fff;" class="btn"><i class="fa-solid fa-trash"></i> حذف</button>` : ''}
          </div>
        `;
        gallery.appendChild(card);
      });
    }

    // دالة الرفع
    async function uploadAsset() {
      const fileInput = document.getElementById('assetFile');
      const titleInput = document.getElementById('assetTitle');
      const file = fileInput.files[0];
      if (!file) return alert('الرجاء اختيار ملف!');

      showToast('⏳ جاري الرفع...');
      const filePath = `vault_${Date.now()}_${file.name}`;
      
      const { data: storageData, error: storageError } = await _supabase.storage.from('Gallery').upload(filePath, file);
      if (storageError) return alert('خطأ في الرفع: ' + storageError.message);

      const { data: publicUrlData } = _supabase.storage.from('Gallery').getPublicUrl(filePath);

      await _supabase.from('photos').insert([{ title: titleInput.value, url: publicUrlData.publicUrl, storage_path: filePath }]);

      showToast('✅ تم الرفع بنجاح!');
      fileInput.value = '';
      titleInput.value = '';
      render();
    }

    // دالة الحذف
    async function deleteAsset(id, storagePath) {
      if (!confirm('هل أنت تأكد من حذف هذا الملف؟')) return;
      if (storagePath) await _supabase.storage.from('Gallery').remove([storagePath]);
      await _supabase.from('photos').delete().eq('id', id);
      showToast('🗑️ تم الحذف');
      render();
    }

    // دالة التنزيل المباشر
    async function downloadAsset(url, title, itemId) {
      showToast('⏳ جاري إعداد التنزيل...');
      try {
        const response = await fetch(url);
        const blob = await response.blob();
        const blobUrl = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.style.display = 'none';
        a.href = blobUrl;
        const ext = url.split('.').pop().split('?')[0] || 'jpg';
        a.download = `${title || 'Shelby_Vault'}.${ext}`;
        document.body.appendChild(a);
        a.click();
        window.URL.revokeObjectURL(blobUrl);
        a.remove();
        showToast('✅ تم التنزيل بنجاح');
      } catch (err) {
        window.open(url, '_blank');
      }
    }

    // تشغيل العرض عند فتح الصفحة
    render();
  </script>
</body>
</html>
